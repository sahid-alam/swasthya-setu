# Copy to .env and fill in.
#
# Comments live on their own line here, never after a value: this parser keeps
# everything to the right of the `=`, trailing `# comment` included, which is how a
# perfectly good API token becomes a 404 nobody can explain.

# --- Core ---
DATABASE_URL=postgresql+asyncpg://setu:setu@localhost:5432/swasthya
REDIS_URL=redis://localhost:6379/0
# HS256: use 32+ bytes outside dev
JWT_SECRET=change-me
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
# time compression for simulators (demo: 120)
SIM_SPEED=1
# Seeded staff login. Leave empty and `make seed` generates one, writes it to the
# gitignored .admin-password, and prints it. A password in a repo is not a password.
ADMIN_PASSWORD=

# --- Adapters: default ALL mock. Flip per-service only when creds exist. ---

# Meta WhatsApp Cloud API. Free-form text reaches a patient only within 24h of their
# last message; outside that window it must be a template Meta approved, named in
# WHATSAPP_TEMPLATES like {"otp":{"name":"setu_otp","lang":"en","params":["code"]}}
WHATSAPP_MOCK_MODE=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATES=
WHATSAPP_TEST_RECIPIENT=

# SMS: an Android running the Traccar SMS Gateway app. SMS_GATEWAY_URL is a LAN
# address such as http://192.168.1.7:8082 — never localhost, least of all from inside
# compose. Live SMS is capped at 30/day and 5/minute and never runs in tests.
SMS_MOCK_MODE=true
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_TEST_RECIPIENT=

# Telegram @Swasthya_Setu_bot. Free, and the only channel a patient must opt into: a
# bot cannot message anyone who has not messaged it, so they share their contact first.
TELEGRAM_MOCK_MODE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Swasthya_Setu_bot
TELEGRAM_TEST_CHAT_ID=

# Email. SMTP_PASSWORD is a 16-character Google APP password, never the account one.
# SMTP_FROM defaults to SMTP_USERNAME.
EMAIL_MOCK_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
# An inbox you can actually open: `make seed` puts it on the first patient so email OTP
# is demoable. It must look like an address — anything else is ignored with a warning.
DEMO_PATIENT_EMAIL=

# Exotel (IVR + outbound TTS)
TELEPHONY_MOCK_MODE=true
EXOTEL_SID=
EXOTEL_TOKEN=

# --- Vapi voice agent (dashboard web call). The IVR line is the offline fallback. ---
# VAPI_API is the PUBLIC key (browser side). Only the private key creates assistants.
VAPI_API=
VAPI_PRIVATE_KEY=
# printed by infra/vapi_setup.py
VAPI_ASSISTANT_ID=
# Any long random string. Vapi sends it back on every tool call; unset = endpoint closed.
VAPI_TOOL_SECRET=
# Accepted by the create call; this API version has no voice-list endpoint.
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
# Where Vapi reaches us from the internet. `make tunnel` sets it per run; empty means
# the assistant can talk but cannot book.
PUBLIC_BASE_URL=
# The browser only ever sees VITE_-prefixed vars, which is why the public key appears
# twice and the private one never does. Empty = the dashboard button says it is not
# configured, and Vite drops the 300 kB voice SDK from the bundle entirely.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# --- Not yet built ---
BHASHINI_MOCK_MODE=true
BHASHINI_API_KEY=
ERAKTKOSH_MOCK_MODE=true
# sandbox only, ever (Tier 3 = production)
ABDM_MOCK_MODE=true
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# local container with HP extract
OSRM_URL=http://localhost:5000
