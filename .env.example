# --- Core ---
DATABASE_URL=postgresql+asyncpg://setu:setu@localhost:5432/swasthya
REDIS_URL=redis://localhost:6379/0
COUCHDB_URL=http://admin:admin@localhost:5984
JWT_SECRET=change-me             # HS256: use 32+ bytes outside dev
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
SIM_SPEED=1                      # time compression for simulators (demo: 120)

# --- Adapters: default ALL mock. Flip per-service only when creds exist. ---
WHATSAPP_MOCK_MODE=true          # Meta WhatsApp Cloud API — read by adapters/factory.py
WHATSAPP_TOKEN=
SMS_MOCK_MODE=true               # MSG91 — read by adapters/factory.py
MSG91_AUTH_KEY=
TELEPHONY_MOCK_MODE=true         # Exotel (IVR + outbound TTS)
EXOTEL_SID=
EXOTEL_TOKEN=
BHASHINI_MOCK_MODE=true
BHASHINI_API_KEY=
ERAKTKOSH_MOCK_MODE=true
ABDM_MOCK_MODE=true              # sandbox only, ever (Tier 3 = production)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
OSRM_URL=http://localhost:5000   # local container with HP extract
