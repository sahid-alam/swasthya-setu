# --- Core ---
DATABASE_URL=postgresql+asyncpg://setu:setu@localhost:5432/swasthya
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me             # HS256: use 32+ bytes outside dev
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
SIM_SPEED=1                      # time compression for simulators (demo: 120)

# --- Adapters: default ALL mock. Flip per-service only when creds exist. ---
WHATSAPP_MOCK_MODE=true          # Meta WhatsApp Cloud API — read by adapters/factory.py
WHATSAPP_TOKEN=                  # access token from the app's WhatsApp panel
WHATSAPP_PHONE_NUMBER_ID=        # the test number's ID, not the number itself
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATES=              # {"otp":{"name":"setu_otp","lang":"en","params":["code"]}}
                                 # a message named here goes as an APPROVED template and
                                 # works cold; anything else goes as free-form text, which
                                 # Meta allows only within 24h of the patient messaging you
WHATSAPP_TEST_RECIPIENT=         # a verified recipient, for the live contract test only
SMS_MOCK_MODE=true               # MSG91 — read by adapters/factory.py
MSG91_AUTH_KEY=
EMAIL_MOCK_MODE=true             # false = real SMTP, needs the block below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=                   # you@gmail.com
SMTP_PASSWORD=                   # 16-char Google APP password, never the account one
SMTP_FROM=                       # "Swasthya-Setu <you@gmail.com>"; defaults to SMTP_USERNAME
SMTP_TIMEOUT_SECONDS=10
DEMO_PATIENT_EMAIL=              # `make seed` puts this on the first patient, so email
                                 # OTP can be demoed against an inbox you can open
TELEPHONY_MOCK_MODE=true         # Exotel (IVR + outbound TTS)
EXOTEL_SID=
EXOTEL_TOKEN=
BHASHINI_MOCK_MODE=true
BHASHINI_API_KEY=
ERAKTKOSH_MOCK_MODE=true
ABDM_MOCK_MODE=true              # sandbox only, ever (Tier 3 = production)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
OSRM_URL=http://localhost:5000   # local container with HP extract

# --- Vapi voice agent (dashboard web call). The IVR line is the offline fallback. ---
VAPI_API=                        # PUBLIC key — browser side, safe in the bundle
VAPI_PRIVATE_KEY=                # server side; only this one can create assistants
VAPI_ASSISTANT_ID=               # printed by infra/vapi_setup.py
VAPI_TOOL_SECRET=                # Vapi sends this header on every tool call; unset = endpoint closed
VAPI_VOICE_PROVIDER=vapi         # accepted by the create call; there is no voice-list API
VAPI_VOICE_ID=Elliot
# The browser only ever sees VITE_-prefixed vars, which is why the public key is
# duplicated here and the private one is not. Empty = the dashboard button says it is
# not configured, and Vite drops the 300 kB voice SDK from the bundle entirely.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=                 # where Vapi reaches us from the internet, e.g. https://api.example.com
                                 # empty = the assistant can talk but cannot book
